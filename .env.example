# =====================
# 이 파일을 복사해서 .env 로 만들고 값을 채워주세요
# .env 파일은 절대 GitHub에 올리지 마세요!
# =====================

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=drawing_diary
DB_USER=admin
DB_PASSWORD=여기에_비밀번호_입력

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=여기에_랜덤_문자열_입력_최소32자이상

# AI API Keys
GEMINI_API_KEY=여기에_Gemini_API_키_입력
HUGGINGFACE_API_TOKEN=여기에_HuggingFace_토큰_입력
